# Docker Compose (PostgreSQL + Redis)
POSTGRES_USER=libris
POSTGRES_PASSWORD=libris
POSTGRES_DB=libris
POSTGRES_PORT=5432
REDIS_PORT=6379

# Bản production của libris-ai + libris-api (docker-compose.prod.yml)
JWT_SECRET=                 # openssl rand -base64 32
INTERNAL_API_TOKEN=         # openssl rand -hex 32 – libris-api dùng để gọi libris-ai
LLM_API_KEY=                # khóa Gemini (Google AI Studio)
WEB_ORIGIN=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
RERANK_CANDIDATES=20        # 10: nhanh gấp đôi trên CPU, chất lượng giảm nhẹ (xem libris-ai/eval/README.md)
RERANKER_ENABLED=true       # false: tiết kiệm ~2,3 GB RAM, chất lượng truy xuất giảm rõ
