PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://libris:libris@localhost:5432/libris

# Khóa ký access token, tối thiểu 32 byte: openssl rand -base64 32
JWT_SECRET=
JWT_TTL=2h

# libris-ai (FastAPI). AI_SERVICE_TOKEN phải trùng INTERNAL_API_TOKEN của libris-ai
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
MAX_UPLOAD_MB=30

# Tài khoản quản trị đầu tiên, tạo khi khởi động nếu email chưa tồn tại
ADMIN_EMAIL=
ADMIN_PASSWORD=
