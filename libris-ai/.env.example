DATABASE_URL=postgresql://libris:libris@localhost:5432/libris
REDIS_URL=redis://localhost:6379/0

# Mô hình embedding (Task 2.2)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_PRELOAD=false

# Cross-encoder reranker (Task 3.3). Chạy CPU: nên đặt RERANK_CANDIDATES=10 (~9 giây/câu hỏi)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANK_CANDIDATES=20
RERANK_TOP_N=5
RERANKER_PRELOAD=false

# LLM sinh câu trả lời (Task 3.4) – API tương thích OpenAI. Mặc định: Gemini (Google AI Studio)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=["gemini-3.5-flash","gemini-flash-lite-latest"]
LLM_TEMPERATURE=0.1
ANSWER_MIN_RERANK_SCORE=0.2

# Token nội bộ giữa libris-api và libris-ai (header X-Internal-Token). Bắt buộc khi triển khai;
# tạo bằng: openssl rand -hex 32. Phải trùng với AI_SERVICE_TOKEN của libris-api.
INTERNAL_API_TOKEN=

# Văn bản Admin tải lên (Task 4.1)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=30
